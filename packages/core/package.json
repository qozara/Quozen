{
    "name": "@quozen/core",
    "version": "1.0.0",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsup src/index.ts --format esm --dts && node scripts/validate-schemas.js",
        "dev": "tsup src/index.ts --format esm --watch --dts",
        "lint": "tsc --noEmit",
        "test": "vitest run",
        "test:all:non-interactive": "npm run test",
        "test:all": "npm run test"
    },
    "devDependencies": {
        "tsup": "^8.5.1",
        "typescript": "^5.0.0"
    },
    "dependencies": {
        "@qozara/cloud-sync": "^2.0.0",
        "@qozara/cloud-sync-google": "^2.0.0",
        "rxdb": "^17.5.0",
        "rxjs": "^7.8.1"
    }
}
